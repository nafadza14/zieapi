# Apizie environment. Variables were named ZIE_* before the rebrand; those names still work.
# ---- core ----
PORT=8787
APIZIE_PUBLIC_URL=http://localhost:8787        # your site URL (used for OAuth callbacks, links)
APIZIE_ADMIN_EMAILS=you@example.com            # comma-separated; these accounts become admins
APIZIE_SESSION_SECRET=change-me-long-random    # REQUIRED on Vercel: signs sign-in state and encrypts API keys so they can be revealed later
APIZIE_DATA_FILE=./data/apizie.json            # local JSON snapshot (ignored when Supabase or Upstash is set)

# ---- Supabase (database + Google sign-in) ----
# Run supabase/migrations/0001_apizie.sql once in the Supabase SQL editor.
SUPABASE_PROJECT_ID=hfscpcwrntvdslxwddjy
SUPABASE_PUBLISHABLE_KEY=sb_publishable_uHZn89sA8wCHmyIh5vYqZA_SYXo1BZ8   # public, used for Google sign-in
# SUPABASE_SECRET_KEY=sb_secret_...        # server only. Never commit it. Set it in Vercel env vars.
# SUPABASE_AUTH_PROVIDERS=google           # comma-separated Supabase providers shown on /login
# Supabase Redirect URLs must include {APIZIE_PUBLIC_URL}/auth/supabase/callback

# ---- alternative storage (Upstash Redis REST) ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# ---- sign-in providers (optional; buttons appear when set) ----
# GitHub: create an OAuth App, callback = {APIZIE_PUBLIC_URL}/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Callback URLs: {APIZIE_PUBLIC_URL}/auth/github/callback, /auth/google/callback, /auth/discord/callback

# ---- billing (manual bank transfer) ----
# APIZIE_BANK_INFO="BCA 1234567890 a.n. PT Zieads Digital"
# APIZIE_VAT_PERCENT=11            # VAT added to every invoice (default 11)
# APIZIE_AFFILIATE_PERCENT=10      # referrer's share of each paid invoice, before VAT (default 10)

# ---- support + notifications ----
# APIZIE_SUPPORT_EMAIL=hello@zieads.com
# APIZIE_DISCORD_URL=https://discord.gg/...
# RESEND_API_KEY=re_...            # optional: also email dashboard notifications through Resend
# APIZIE_EMAIL_FROM="Apizie <noreply@yourdomain.com>"
# APIZIE_WEBHOOKS_ALLOW_PRIVATE=1  # local testing only: lets webhooks reach localhost/LAN

# ---- fixed API keys without an account (plan:key, comma-separated) ----
# APIZIE_KEYS=ultra:apz_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- upstream adapter for catalog endpoints not implemented locally ----
# APIZIE_UPSTREAM_URL=https://api.example.com
# APIZIE_UPSTREAM_KEY=
# APIZIE_UPSTREAM_HEADER=x-api-key

# ---- optional scraper API keys ----
# FRED_API_KEY=
# GITHUB_TOKEN=
# NCBI_API_KEY=
# NCBI_EMAIL=
# STACKEXCHANGE_KEY=
# JINA_API_KEY=
# SSLLABS_EMAIL=

# Optional shared provider keys for global APIs (callers can also send x-upstream-key)
# APIZIE_UPSTREAM_KEY_FINANCE_STRIPE=
# APIZIE_UPSTREAM_KEY_COMMUNICATION_SENDGRID=
