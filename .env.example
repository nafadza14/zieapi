# ---- core ----
PORT=8787
ZIE_PUBLIC_URL=http://localhost:8787        # your site URL (used for OAuth callbacks, links)
ZIE_ADMIN_EMAILS=you@example.com            # comma-separated; these accounts become admins
ZIE_SESSION_SECRET=change-me-long-random    # signs OAuth state
ZIE_DATA_FILE=./data/zieapi.json            # local JSON snapshot (ignored when Supabase or Upstash is set)

# ---- Supabase (database + Google sign-in) ----
# Run supabase/migrations/0001_zieapi.sql once in the Supabase SQL editor.
SUPABASE_PROJECT_ID=hfscpcwrntvdslxwddjy
SUPABASE_PUBLISHABLE_KEY=sb_publishable_uHZn89sA8wCHmyIh5vYqZA_SYXo1BZ8   # public, used for Google sign-in
# SUPABASE_SECRET_KEY=sb_secret_...        # server only. Never commit it. Set it in Vercel env vars.
# SUPABASE_AUTH_PROVIDERS=google           # comma-separated Supabase providers shown on /login
# Supabase Redirect URLs must include {ZIE_PUBLIC_URL}/auth/supabase/callback

# ---- alternative storage (Upstash Redis REST) ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# ---- sign-in providers (optional; buttons appear when set) ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Callback URLs: {ZIE_PUBLIC_URL}/auth/github/callback, /auth/google/callback, /auth/discord/callback

# ---- billing (manual bank transfer) ----
# ZIE_BANK_INFO="BCA 1234567890 a.n. PT Zieads Digital"

# ---- fixed API keys without an account (plan:key, comma-separated) ----
# ZIE_KEYS=ultra:zie_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- upstream adapter for catalog endpoints not implemented locally ----
# ZIE_UPSTREAM_URL=https://api.example.com
# ZIE_UPSTREAM_KEY=
# ZIE_UPSTREAM_HEADER=x-api-key

# ---- optional scraper API keys ----
# FRED_API_KEY=
# GITHUB_TOKEN=
# NCBI_API_KEY=
# NCBI_EMAIL=
# STACKEXCHANGE_KEY=
# JINA_API_KEY=
# SSLLABS_EMAIL=

# Optional shared provider keys for global APIs (callers can also send x-upstream-key)
# ZIE_UPSTREAM_KEY_FINANCE_STRIPE=
# ZIE_UPSTREAM_KEY_COMMUNICATION_SENDGRID=
