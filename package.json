{
  "name": "zieapi",
  "version": "2.0.0",
  "description": "zieapi \u2014 full public-data API platform: website, dashboard, admin, 290+ scrapers catalog, API keys, plans, billing, webhooks, bulk and MCP. Zero dependencies.",
  "type": "module",
  "main": "src/app.js",
  "bin": {
    "zieapi": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "key:generate": "node scripts/gen-key.js",
    "import:catalog": "node scripts/import-catalog.js docs/evidence/zapi-catalog-capture.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "api",
    "scraper",
    "gateway",
    "mcp",
    "indonesia",
    "rate-limit"
  ],
  "author": "Zieads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nafadza14/zieapi.git"
  }
}
